rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Profile photos — readable by anyone signed in, writable by owner.
    match /users/{userId}/profile/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024; // 5 MB
    }

    // Chat media — readable and writable by signed-in users (conversation
    // participant check is enforced at the Firestore message level).
    match /conversations/{conversationId}/media/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 100 * 1024 * 1024; // 100 MB
    }

    // Status media — readable by any signed-in user, writable by owner.
    match /status/{userId}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 100 * 1024 * 1024;
    }
  }
}
